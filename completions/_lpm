#compdef lpm
# lpm zsh completion
# install: cp _lpm /usr/share/zsh/site-functions/_lpm
# or: source this file in ~/.zshrc

_lpm_installed_pkgs() {
    lpm list 2>/dev/null | awk '{print $1}'
}

_lpm_cached_pkgs() {
    ls /usr/src/lpm 2>/dev/null | sed -n 's/^pkgbuild_//p'
}

_lpm() {
    local state

    _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '(-V --version)'{-V,--version}'[show version]' \
        '1:command:->command' \
        '*:args:->args' \
        && return 0

    case $state in
        command)
            local commands=(
                'install:install packages'
                'remove:remove packages'
                'upgrade:upgrade packages (all if no args)'
                'update:sync package databases'
                'search:search available packages'
                'info:show package information'
                'deps:show dependency tree'
                'list:list installed packages'
                'owns:show which package owns a file'
                'files:list files in a package'
                'orphans:show orphaned packages'
                'cache:manage package cache'
                'verify:verify installed package integrity (files/checksum/perms/owner)'
                'test:run a package'\''s check() test suite'
                'audit:show audit log'
                'bootstrap:install base system into a target dir (-C <target>)'
                'repo:repo management'
                'package:package tools (build/pack)'
                'key:key management'
            )
            _describe 'command' commands
            ;;

        args)
            case $words[2] in
                install|info|deps|test)
                    _arguments \
                        '1:package:($(_lpm_cached_pkgs))' \
                        '--no-confirm[skip confirmation]' \
                        '--no-check[skip check() phase]' \
                        '--dry-run[simulate without changes]' \
                        '--force[override conflict checks]' \
                        '--debug=[debug level (1-3)]:level:(1 2 3)'
                    ;;

                remove|files)
                    _arguments \
                        '1:package:($(_lpm_installed_pkgs))' \
                        '--no-confirm[skip confirmation]' \
                        '--dry-run[simulate without changes]' \
                        '--force[override conflict checks]'
                    ;;

                upgrade)
                    _arguments \
                        '*:package:($(_lpm_installed_pkgs))' \
                        '--no-confirm[skip confirmation]' \
                        '--dry-run[simulate without changes]'
                    ;;

                verify)
                    _arguments \
                        '--deps[check dependency consistency across the system]' \
                        '*:package:($(_lpm_installed_pkgs))'
                    ;;

                search)
                    _arguments \
                        '--debug=[debug level (1-3)]:level:(1 2 3)'
                    ;;

                cache)
                    local cache_cmds=('clean:remove old cached packages' 'clear:alias for clean')
                    _describe 'subcommand' cache_cmds
                    ;;

                repo)
                    local repo_cmds=(
                        'list:list configured repos'
                        'add:add a repo'
                        'remove:remove a repo'
                        'sync:sync repo databases'
                    )
                    _describe 'subcommand' repo_cmds
                    ;;

                bootstrap)
                    # lpm bootstrap -C <target> [pkg...]
                    if [[ $words[3] == "-C" ]]; then
                        _arguments \
                            '3:target:_directories' \
                            '*:package:($(_lpm_cached_pkgs))'
                    else
                        _arguments '3:flag:(-C)'
                    fi
                    ;;

                package)
                    local p_cmds=(
                        'build:build package from PKGBUILD'
                        'pack:build and pack to .lpkg'
                        'install:install from .lpkg file'
                        'query:query .lpkg info'
                        'extract:extract .lpkg into current dir'
                        'verify:verify .lpkg checksum and metadata'
                        'remove:remove cached .lpkg file'
                    )
                    _describe 'subcommand' p_cmds
                    ;;

                key)
                    local k_cmds=(
                        'init:initialize keyring'
                        'genid:generate a random key id'
                        'list:list keys in keyring'
                        'recv:receive key from keyserver'
                        'import:import key file'
                        'trust:set key to ultimate trust'
                    )
                    _describe 'subcommand' k_cmds
                    ;;

                owns)
                    _arguments '1:path:_files'
                    ;;
            esac
            ;;
    esac
}

_lpm "$@"
